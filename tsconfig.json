{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"],
  "exclude": [
    "src/engines",
    "src/adapters",
    "src/cli.ts",
    "src/kernel"
  ]
}
