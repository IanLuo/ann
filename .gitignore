node_modules/
dist/
coverage/
# The store write-rev ledger (store-external integrity guard) — a DERIVED local
# integrity view, not source data: gitignored so a checkout re-bootstraps from the
# store's current state (which IS the baseline) instead of churning on every append.
.ann/journey/.ledger.json
.ann/journey/.ledger.json.tmp

# Environment + runtime scratch — never source data. .direnv/ is generated env
# symlinks; logs/ is per-run working state (the provider op-log records prompts,
# so it must never be committed).
.direnv/
logs/

# The canvas skill's local scratch — one directory per topic (generated shell, notes,
# history, worker cards). Local collaboration state on this disk, never source data;
# gitignored so a `git add -A` cannot sweep a canvas into the repo.
.agents/canvas/
